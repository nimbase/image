# Package

version       = "0.1.0"
author        = "Nimbase Community"
description   = "Pure-Nim image encoders/decoders supporting PNG, JPEG, TIFF, WebP, GIF, OpenEXR, BMP, HEIF/HEIC and RAW formats"
license       = "MIT OR Apache-2.0"
srcDir        = "src"


# Dependencies

requires "nim >= 2.2.0"
requires "archive >= 0.1.0"
requires "nimsimd >= 1.3.2"
